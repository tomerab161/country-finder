{
  "name": "country-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Find countries intersected by a GeoJSON polygon or multipolygon.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "seed": "tsx seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "^5.4.0",
    "mongodb": "^6.17.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
